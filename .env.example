# Add your Google OAuth Web client ID here (this ID is public and safe for frontend use).
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Add the origin where your backend API is reachable from the browser.
VITE_API_BASE_URL=http://localhost:3000

# Add the same Google OAuth Web client ID configured for VITE_GOOGLE_CLIENT_ID.
# This public client ID lets the backend verify Google ID tokens; no client secret is needed.
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Frontend origin allowed to call the backend (used for credentialed CORS).
FRONTEND_ORIGIN=http://localhost:5173

# Backend server port.
PORT=3000

# Local PostgreSQL settings for docker-compose.yml.
POSTGRES_DB=stretchmaster
POSTGRES_USER=stretchmaster
# Replace this with a strong local development password.
POSTGRES_PASSWORD=change-me-to-a-strong-password
